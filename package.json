{
  "name": "workflow-recorder",
  "version": "1.3.1",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "test:integration": "node --test e2e/lifecycle.spec.js",
    "test:all": "npm test && npm run test:integration",
    "check": "node scripts/check-js.js",
    "lint": "node scripts/check-js.js",
    "extension:key": "node scripts/generate-extension-key.js",
    "extension:key:create": "node scripts/generate-extension-key.js --create",
    "package": "node scripts/package.js",
    "build": "npm run package"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "fflate": "^0.8.3"
  }
}
